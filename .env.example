# ── Anthropic ─────────────────────────────────────────────────────────────
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# ── Email (Gmail example) ─────────────────────────────────────────────────
# The address that SENDS the digest
EMAIL_FROM=your-sender@gmail.com

# Your Gmail App Password (NOT your regular password)
# Generate at: https://myaccount.google.com/apppasswords
EMAIL_PASS=xxxx-xxxx-xxxx-xxxx

# The address that RECEIVES the digest (can be the same)
EMAIL_TO=your-inbox@gmail.com

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587

# ── Agent behavior ────────────────────────────────────────────────────────
# What companies/sectors to monitor. Examples:
#   "any publicly traded company"
#   "tech companies, AI startups, semiconductor companies"
#   "Apple, Microsoft, Google, Meta, Amazon"
SEARCH_TARGETS=any publicly traded company

# Cron schedule (default: 8am, 1pm, 7pm server time)
# Format: minute hour * * *
CRON_SCHEDULE=0 8,13,19 * * *
